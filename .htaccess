</FilesMatch>

<FilesMatch "^(Database|AuthService|AgreementService|DealerService|ExpenseService|GoodsReceiptService|InventoryService|LookupService|PaymentService|ProductReturnService|ProductService|PurchaseService|ReportingService|SalesService|SettingsService|SupplyService|Code|Config)\.gs$">
